# 阿里云 NLS (ASR + TTS)。可留空启动；语音识别/云 TTS 接口会返回 503。
NLS_APPKEY=
NLS_TOKEN=
NLS_VOICE=cally
NLS_TTS_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
NLS_ASR_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr

# 阿里云 SSECP (口语评测 en.sent_kid.score)。留空时自动使用本地 Mock 评分。
SSECP_APP_ID=
SSECP_APP_SECRET=
SSECP_USER_CLIENT_IP=127.0.0.1
SSECP_AUTH_URLS=https://api.cloud.ssapi.cn/auth/authorize,https://gate-01.api.cloud.ssapi.cn/auth/authorize,https://gate-02.api.cloud.ssapi.cn/auth/authorize,https://gate-03.api.cloud.ssapi.cn/auth/authorize
SSECP_EVAL_URL_TEMPLATE=wss://api.cloud.ssapi.cn/{core_type}?connect_id={connect_id}

# Backend (留空会用默认: server/data/app.db, server/audio)
DATABASE_URL=
AUDIO_STORAGE_DIR=

# 业务
PASS_THRESHOLD=90.0

# DeepSeek (AI 英语伙伴) - 从 https://platform.deepseek.com 获取 key
# Key 只放服务端 .env，禁止写入 Expo 的 EXPO_PUBLIC_* 环境变量。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
