# 阿里云 NLS (ASR + TTS)。可留空启动；语音识别/云 TTS 接口会返回 503。
NLS_APPKEY=
NLS_TOKEN=
NLS_TOKEN_EXPIRES_AT=0
NLS_VOICE=cally
NLS_TTS_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
NLS_ASR_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/asr

# 正式环境使用 RAM 用户 AccessKey 自动获取/刷新 NLS Token。
# RAM 用户只授予所需的 NLS 权限；不要将 AccessKey 放进移动端。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_REGION_ID=cn-shanghai

# 阿里云 SSECP (口语评测 en.sent_kid.score)。留空时自动使用本地 Mock 评分。
SSECP_APP_ID=
SSECP_APP_SECRET=
SSECP_USER_CLIENT_IP=127.0.0.1
SSECP_AUTH_URLS=https://api.cloud.ssapi.cn/auth/authorize,https://gate-01.api.cloud.ssapi.cn/auth/authorize,https://gate-02.api.cloud.ssapi.cn/auth/authorize,https://gate-03.api.cloud.ssapi.cn/auth/authorize
SSECP_EVAL_URL_TEMPLATE=wss://api.cloud.ssapi.cn/{core_type}?connect_id={connect_id}

# Backend (留空会用默认: server/data/app.db, server/audio)
DATABASE_URL=
AUDIO_STORAGE_DIR=
CONTENT_STORAGE_DIR=
CONTENT_MAX_UPLOAD_MB=25

# 应用与鉴权。生产环境必须替换 JWT_SECRET_KEY，并使用 PostgreSQL DATABASE_URL。
APP_ENV=development
JWT_SECRET_KEY=development-only-change-me-before-production
JWT_ISSUER=en-teach
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8083,http://127.0.0.1:8083
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# 通知 outbox。开发默认 mock；生产可设为 email,apns，并替换对应发送适配器。
NOTIFICATION_CHANNELS=mock
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_BASE_SECONDS=60

# 业务
PASS_THRESHOLD=90.0

# DeepSeek (AI 英语伙伴) - 从 https://platform.deepseek.com 获取 key
# Key 只放服务端 .env，禁止写入 Expo 的 EXPO_PUBLIC_* 环境变量。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
