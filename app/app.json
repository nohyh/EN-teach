{
  "expo": {
    "name": "EN-teach",
    "slug": "nohyh",
    "version": "0.1.3",
    "scheme": "enteach",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-router",
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许 Lumi 使用麦克风进行语音输入和跟读评分。"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "844cf830-adfe-47f4-9624-403adddf7e24"
      }
    },
    "owner": "cwwccoffee",
    "android": {
      "package": "com.nohyhsteam.nohyh",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    }
  }
}
